# Required for first commissioning and Maker activation.
# Do not commit real values. Configure these in Portainer Stack environment variables.
GATEWAY_ADMIN_PASSWORD=change-me
IGNITION_LICENSE_KEY=ABCD-1234
IGNITION_ACTIVATION_TOKEN=replace-with-your-activation-token

# Optional overrides.
